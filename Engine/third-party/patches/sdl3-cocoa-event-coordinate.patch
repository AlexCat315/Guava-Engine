 static void Cocoa_ReconcileButtonState(NSEvent *event)
 {
+    // Explicit button/drag events describe the state at their own timestamp.
+    // A current hardware query can already reflect a later queued release (or
+    // omit synthesized events), causing a premature mouse-up at an old point.
+    switch ([event type]) {
+    case NSEventTypeLeftMouseDown:
+    case NSEventTypeLeftMouseUp:
+    case NSEventTypeRightMouseDown:
+    case NSEventTypeRightMouseUp:
+    case NSEventTypeOtherMouseDown:
+    case NSEventTypeOtherMouseUp:
+    case NSEventTypeLeftMouseDragged:
+    case NSEventTypeRightMouseDragged:
+    case NSEventTypeOtherMouseDragged:
+        return;
+    default:
+        break;
+    }
+
     // Send mouse up events for any buttons that are no longer pressed
     Uint32 buttons = SDL_GetMouseState(NULL, NULL);
     if (buttons && ![NSEvent pressedMouseButtons]) {
