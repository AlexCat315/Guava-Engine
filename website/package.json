  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "beasties": "^0.3.5",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.1.2",
    "markdown-it-anchor": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-vue-markdown": "^32.1.1",
