    "beasties": "^0.3.5",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.9.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.0.0",
    "markdown-it-anchor": "^9.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
